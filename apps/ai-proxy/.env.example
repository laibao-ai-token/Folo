# Copy to .env.local and set your key (placeholder below)
# Never commit a real key into the repo
IFLOW_API_KEY=sk-xxxx
PORT=3000
# Optional: override default model if iflow 不支持 gpt-4o-mini
# You can also leave it empty and pick in UI
DEFAULT_MODEL=gpt-4o-mini
# Optional: default temperature for chat completions (0.0–2.0; provider-specific)
DEFAULT_TEMPERATURE=1
# Optional: default max output tokens for responses
# Increase if summaries are truncated
DEFAULT_MAX_OUTPUT_TOKENS=6000
# Optional: default response language for summaries
# e.g. zh-CN, en, ja. Can be overridden per request via
# body.language/body.lang, X-Language header, or Accept-Language.
DEFAULT_RESPONSE_LANGUAGE=zh-CN
# Optional: Follow API base for resolving "Current" entry content
# If not set, defaults to https://api.follow.is
UPSTREAM_API_URL=https://api.follow.is
# Optional: If upstream requires auth, paste your session token
# (copy from browser cookies __Secure-better-auth.session_token)
# Note: keep this secret!
UPSTREAM_SESSION_TOKEN=

# Debug: print full prompt/context to console (development only)
# Set to 1/true to enable verbose logging of the first 32k characters.
# - DEBUG_AI_PROXY_PROMPT: logs full prompt text for timeline-summary
# - DEBUG_AI_PROXY_CONTEXT: logs injected "Current entry" context text
DEBUG_AI_PROXY_PROMPT=
DEBUG_AI_PROXY_CONTEXT=
